----------------------------------------------------------------------
-- FARM TAB
----------------------------------------------------------------------
do
	local page = createPage("Farm", "🌾", "Auto collect seeds and gems", 3)

	local TELEPORT_DELAY = 0.25 -- seconds between each target (raise it if some don't register)
	local GEM_NAMES = { Emerald = true, Ruby = true, Sapphire = true, Diamond = true }

	local function getRoot()
		local char = player.Character
		return char and char:FindFirstChild("HumanoidRootPart")
	end

	-- getTargets() returns parts/models to visit. onCount(n) reports how many were found.
	local function makeFarm(label, getTargets, onCount)
		local running = false

		local function start()
			if running then
				return
			end
			running = true
			print("[Farm] " .. label .. " started, targets found: " .. #getTargets())

			task.spawn(function()
				while running do
					local targets = getTargets()
					if onCount then
						onCount(#targets)
					end
					local didTeleport = false

					for _, target in ipairs(targets) do
						if not running then
							break
						end
						local root = getRoot()
						if root and target.Parent then
							local cf
							if target:IsA("BasePart") then
								cf = target.CFrame
							elseif target:IsA("Model") then
								cf = target:GetPivot()
							end
							if cf then
								root.CFrame = cf * CFrame.new(0, 2, 0)
								didTeleport = true
								task.wait(TELEPORT_DELAY)
							end
						end
					end

					if not didTeleport then
						task.wait(0.5) -- nothing to visit right now, check again soon
					end
				end
			end)
		end

		local function stop()
			running = false
		end

		return start, stop
	end

	-- Seeds: every part inside workspace.Seeds
	local function getSeeds()
		local folder = workspace:FindFirstChild("Seeds")
		return folder and folder:GetChildren() or {}
	end

	-- Gems: anything named Emerald / Ruby / Sapphire / Diamond anywhere in workspace
	local function getGems()
		local list = {}
		local myChar = player.Character
		for _, inst in ipairs(workspace:GetDescendants()) do
			if GEM_NAMES[inst.Name] and (inst:IsA("BasePart") or inst:IsA("Model")) then
				if not (myChar and inst:IsDescendantOf(myChar)) then
					table.insert(list, inst)
				end
			end
		end
		return list
	end

	local SEED_DEFAULT = "Teleports to every seed in workspace.Seeds"
	local GEM_DEFAULT = "Emerald, Ruby, Sapphire and Diamond"

	local seedToggle, gemToggle
	local startSeeds, stopSeeds = makeFarm("Seeds", getSeeds, function(n)
		if seedToggle then
			seedToggle.SetSubtitle("Running  •  " .. n .. " found")
		end
	end)
	local startGems, stopGems = makeFarm("Gems", getGems, function(n)
		if gemToggle then
			gemToggle.SetSubtitle("Running  •  " .. n .. " found")
		end
	end)

	section(page, "Auto Farm")

	seedToggle = toggle(page, "Seed Farm", function(on)
		if on then
			startSeeds()
			toast("Seed farm enabled", C.good)
		else
			stopSeeds()
			seedToggle.SetSubtitle(SEED_DEFAULT)
			toast("Seed farm disabled", C.sub)
		end
	end, SEED_DEFAULT, { icon = "🌱", color = C.good })

	gemToggle = toggle(page, "Gem Farm", function(on)
		if on then
			startGems()
			toast("Gem farm enabled", C.good)
		else
			stopGems()
			gemToggle.SetSubtitle(GEM_DEFAULT)
			toast("Gem farm disabled", C.sub)
		end
	end, GEM_DEFAULT, { icon = "💎", color = C.accent2 })
end

