----------------------------------------------------------------------
-- DRAGGING (+ keep on screen)
----------------------------------------------------------------------
clampToScreen = function(target)
	local screenSize = gui.AbsoluteSize
	local screenPos = gui.AbsolutePosition
	local size = target.AbsoluteSize
	local pos = target.AbsolutePosition - screenPos
	local keep = 40 -- pixels that must stay visible
	local dx, dy = 0, 0

	if pos.X + size.X < keep then
		dx = keep - (pos.X + size.X)
	elseif pos.X > screenSize.X - keep then
		dx = (screenSize.X - keep) - pos.X
	end

	if pos.Y < 0 then
		dy = -pos.Y
	elseif pos.Y > screenSize.Y - keep then
		dy = (screenSize.Y - keep) - pos.Y
	end

	if dx ~= 0 or dy ~= 0 then
		target.Position = target.Position + UDim2.fromOffset(dx, dy)
	end
end

-- Drag `target` by grabbing `handle`. `onClick` fires if released without dragging.
local function makeDraggable(handle, target, onClick)
	local dragging = false
	local dragStart, startPos
	local moved = 0

	handle.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			moved = 0
			dragStart = input.Position
			startPos = target.Position

			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					conn:Disconnect()
					if onClick and moved < 6 then
						onClick()
					end
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			moved = math.max(moved, delta.Magnitude)
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
			clampToScreen(target)
			if target == main and moved > 6 then
				userMoved = true
			end
		end
	end)
end

