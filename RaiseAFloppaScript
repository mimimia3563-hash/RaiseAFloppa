----------------------------------------------------------------------
-- AUTO SCALE (fits phones / small screens)
----------------------------------------------------------------------
local uiScale = new("UIScale", { Parent = main })
local camera = workspace.CurrentCamera
local baseScale = 1
local userMoved = false
local clampToScreen -- defined in the dragging section

local function recenter()
	main.Position = UDim2.new(0.5, 0, 0.5, -(FULL_SIZE.Y.Offset * baseScale) / 2)
end

local function updateScale()
	local view = camera.ViewportSize
	local s = math.min((view.X - 24) / FULL_SIZE.X.Offset, (view.Y - 24) / FULL_SIZE.Y.Offset, 1)
	baseScale = math.clamp(s, 0.45, 1)
	uiScale.Scale = baseScale
	if not userMoved then
		recenter()
	elseif clampToScreen then
		clampToScreen(main)
	end
end

do
	local t = 0
	while camera.ViewportSize.X <= 1 and t < 2 do -- wait for a real viewport size
		t += task.wait()
	end
end
updateScale()
camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

