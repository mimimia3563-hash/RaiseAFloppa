local tabs = {}
local currentTab = nil

local function selectTab(name)
	for _, t in ipairs(tabs) do
		local active = (t.name == name)
		t.active = active

		if active and currentTab ~= name then
			t.page.Visible = true
			t.page.Position = UDim2.fromOffset(22, 0)
			tween(t.page, { Position = UDim2.fromOffset(0, 0) }, 0.3, Enum.EasingStyle.Quint)
			pageTitle.Text = t.name
			pageSub.Text = t.subtitle
		elseif not active then
			t.page.Visible = false
		end

		tween(t.bg, { BackgroundTransparency = active and 0.82 or 1 }, 0.2)
		tween(t.indicator, { Size = UDim2.fromOffset(3, active and 20 or 0) }, 0.25, Enum.EasingStyle.Back)
		tween(t.label, { TextColor3 = active and C.text or C.sub }, 0.2)
	end
	currentTab = name
end

