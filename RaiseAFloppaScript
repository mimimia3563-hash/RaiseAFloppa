-- Row with a text box + Set button
local function inputRow(page, title, subtitle, placeholder, buttonText, callback, opts)
	opts = opts or {}
	local row = card(page, false)
	badge(row, opts.icon or "🔧", opts.color or C.accent)
	rowText(row, title, subtitle, 176)

	local boxStroke = stroke(C.stroke, 1, 0.2)
	local box = new("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -86, 0.5, 0),
		Size = UDim2.fromOffset(84, 32),
		BackgroundColor3 = C.field,
		Text = opts.default or "",
		PlaceholderText = placeholder or "",
		PlaceholderColor3 = C.sub,
		Font = FONT_MED,
		TextSize = 13,
		TextColor3 = C.text,
		ClearTextOnFocus = false,
		Parent = row,
	}, { corner(8), boxStroke })

	box.Focused:Connect(function()
		tween(boxStroke, { Color = C.accent, Transparency = 0 }, 0.15)
	end)
	box.FocusLost:Connect(function(enterPressed)
		tween(boxStroke, { Color = C.stroke, Transparency = 0.2 }, 0.15)
		if enterPressed and callback then
			callback(box.Text)
		end
	end)

	if opts.numeric ~= false then
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local cleaned = box.Text:gsub("[^%d%.%-]", "")
			if cleaned ~= box.Text then
				box.Text = cleaned
			end
		end)
	end

	local btn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(66, 32),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = buttonText or "Set",
		Font = FONT_BOLD,
		TextSize = 12,
		TextColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Parent = row,
	}, { corner(8), gradient(C.accent, C.accent2, 45) })

	local s = new("UIScale", { Parent = btn })
	btn.InputBegan:Connect(function(input)
		if isPress(input) then
			tween(s, { Scale = 0.94 }, 0.08)
		end
	end)
	btn.InputEnded:Connect(function(input)
		if isPress(input) then
			tween(s, { Scale = 1 }, 0.18, Enum.EasingStyle.Back)
		end
	end)
	btn.MouseButton1Click:Connect(function()
		if callback then
			callback(box.Text)
		end
	end)

	return box
end

-- On / off switch row. Returns { Set = fn, SetSubtitle = fn }
local function toggle(page, title, callback, subtitle, opts)
	opts = opts or {}
	local state = false
	local row = card(page, true)
	badge(row, opts.icon or "⚙️", opts.color or C.accent)
	local _, subLbl = rowText(row, title, subtitle, 76)

	local track = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(46, 26),
		BackgroundColor3 = C.track,
		BorderSizePixel = 0,
		Parent = row,
	}, { corner(13) })

	local grad = new("UIGradient", {
		Color = ColorSequence.new(C.accent, C.accent2),
		Enabled = false,
		Parent = track,
	})

	local knob = new("Frame", {
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = C.sub,
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(10) })

	local function apply(on)
		grad.Enabled = on
		tween(track, { BackgroundColor3 = on and Color3.new(1, 1, 1) or C.track }, 0.18)
		tween(knob, {
			Position = on and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
			BackgroundColor3 = on and Color3.new(1, 1, 1) or C.sub,
		}, 0.22, Enum.EasingStyle.Back)
	end

	row.MouseButton1Click:Connect(function()
		state = not state
		apply(state)
		if callback then
			callback(state)
		end
	end)

	return {
		Set = function(on)
			state = on
			apply(on)
		end,
		SetSubtitle = function(text)
			subLbl.Text = text
		end,
	}
end

