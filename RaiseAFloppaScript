	toggle(movement, "Fly") -- function goes here later

	local teleportation = createPage("Teleportation", 2)
	local HOUSE_POSITION = Vector3.new(-64, 73, -41)

	section(teleportation, "Places")
	button(teleportation, "Teleport to House", function()
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			root.CFrame = CFrame.new(HOUSE_POSITION)
		end
	end)

	local farm = createPage("Farm", 3)

	-- Auto farms: teleport your character onto each target part, one after another
	local TELEPORT_DELAY = 0.25 -- seconds between each part (raise it if some don't register)
	local GEM_NAMES = { Emerald = true, Ruby = true, Sapphire = true, Diamond = true }

	local function getRoot()
		local char = player.Character
		return char and char:FindFirstChild("HumanoidRootPart")
	end

	-- getTargets() returns a list of parts to visit. Returns start() and stop().
	local function makeFarm(label, getTargets)
		local running = false

		local function start()
			if running then
				return
			end
			running = true
			print("[Farm] " .. label .. " started, targets found: " .. #getTargets())

			task.spawn(function()
				while running do
					local didTeleport = false

					for _, part in ipairs(getTargets()) do
						if not running then
							break
						end
						local root = getRoot()
						if root and part.Parent then
							local cf
							if part:IsA("BasePart") then
								cf = part.CFrame
							elseif part:IsA("Model") then
								cf = part:GetPivot()
							end
							if cf then
								root.CFrame = cf * CFrame.new(0, 2, 0)
								didTeleport = true
								task.wait(TELEPORT_DELAY)
							end
						end
					end

					if not didTeleport then
						task.wait(0.5) -- nothing to visit right now, check again soon
					end
				end
			end)
		end

		local function stop()
			running = false
		end

		return start, stop
	end

	-- Seeds: every part inside workspace.Seeds
	local function getSeeds()
		local folder = workspace:FindFirstChild("Seeds")
		return folder and folder:GetChildren() or {}
	end

	-- Gems: anything named Emerald / Ruby / Sapphire / Diamond anywhere in workspace
	-- (parts or models, inside folders/models too). Skips your own character.
	local function getGems()
		local list = {}
		local myChar = player.Character
		for _, inst in ipairs(workspace:GetDescendants()) do
			if GEM_NAMES[inst.Name] and (inst:IsA("BasePart") or inst:IsA("Model")) then
				if not (myChar and inst:IsDescendantOf(myChar)) then
					table.insert(list, inst)
				end
			end
		end
		return list
	end

	local startSeeds, stopSeeds = makeFarm("Seeds", getSeeds)
	local startGems, stopGems = makeFarm("Gems", getGems)

	section(farm, "Auto Farm")
	toggle(farm, "Teleport to Seeds", function(state)
		if state then
			startSeeds()
		else
			stopSeeds()
		end
	end)
	toggle(farm, "Teleport to Gems", function(state)
		if state then
			startGems()
		else
			stopGems()
		end
	end)
end

