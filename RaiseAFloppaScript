openButton.MouseEnter:Connect(function()
	tween(openScale, { Scale = 1.1 }, 0.15, Enum.EasingStyle.Back)
end)
openButton.MouseLeave:Connect(function()
	tween(openScale, { Scale = 1 }, 0.15)
end)

local isOpen = false
local panelToken = 0

local function setPanelOpen(open)
	isOpen = open
	panelToken += 1
	local token = panelToken

	if open then
		openButton.Visible = false
		main.Visible = true
		main.GroupTransparency = 1
		uiScale.Scale = baseScale * 0.92
		tween(main, { GroupTransparency = 0 }, 0.22)
		tween(uiScale, { Scale = baseScale }, 0.28, Enum.EasingStyle.Back)
	else
		tween(main, { GroupTransparency = 1 }, 0.16)
		tween(uiScale, { Scale = baseScale * 0.92 }, 0.16)
		task.delay(0.17, function()
			if panelToken == token then
				main.Visible = false
			end
		end)
		openScale.Scale = 0.6
		openButton.Visible = true
		tween(openScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
	end
end

-- clicking (without dragging) the image button opens the panel; it can be dragged too
makeDraggable(openButton, openButton, function()
	setPanelOpen(true)
end)

closeBtn.MouseButton1Click:Connect(function()
	setPanelOpen(false)
end)

local minimized = false
minimizeBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	tween(main, {
		Size = minimized and UDim2.fromOffset(FULL_SIZE.X.Offset, HEADER_H) or FULL_SIZE,
	}, 0.3, Enum.EasingStyle.Quint)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if input.KeyCode == TOGGLE_KEY then
		setPanelOpen(not isOpen)
	end
end)

-- Phones/tablets (no keyboard) start with just the button so the panel
-- doesn't cover the game. Everything else starts open.
if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
	setPanelOpen(false)
else
	setPanelOpen(true)
end
