		Parent = parent,
	})
	local s = new("TextLabel", {
		Position = UDim2.fromOffset(54, 29),
		Size = UDim2.new(1, -(54 + rightPad), 0, 16),
		BackgroundTransparency = 1,
		Text = subtitle or "",
		Font = FONT,
		TextSize = 11,
		TextColor3 = C.sub,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = parent,
	})
	return t, s
end

