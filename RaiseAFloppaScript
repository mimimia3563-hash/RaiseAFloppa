----------------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------------
local function new(class, props, children)
	local inst = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do
		inst[k] = v
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

local function stroke(color, thickness, transparency)
	return new("UIStroke", {
		Color = color or C.stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function pad(top, bottom, left, right)
	bottom = bottom or top
	left = left or top
	right = right or left
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
		PaddingRight = UDim.new(0, right),
	})
end

local function gradient(c1, c2, rotation)
	return new("UIGradient", {
		Color = ColorSequence.new(c1, c2),
		Rotation = rotation or 0,
	})
end

local function tween(obj, props, t, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(t or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local layoutCounter = 0
local function nextOrder()
	layoutCounter += 1
	return layoutCounter
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- hover color + little "press" squish for any button
local function pressable(btn, normal, over)
	local s = new("UIScale", { Parent = btn })
	btn.MouseEnter:Connect(function()
		tween(btn, { BackgroundColor3 = over }, 0.12)
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, { BackgroundColor3 = normal }, 0.12)
		tween(s, { Scale = 1 }, 0.1)
	end)
	btn.InputBegan:Connect(function(input)
		if isPress(input) then
			tween(s, { Scale = 0.97 }, 0.08)
		end
	end)
	btn.InputEnded:Connect(function(input)
		if isPress(input) then
			tween(s, { Scale = 1 }, 0.18, Enum.EasingStyle.Back)
		end
	end)
end

